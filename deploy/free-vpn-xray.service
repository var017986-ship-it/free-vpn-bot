[Unit]
Description=Free VLESS REALITY Xray node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xray
Group=xray
EnvironmentFile=/etc/free-vpn-bot/xray.env
ExecStart=/usr/local/bin/xray run -config /etc/free-vpn-bot/xray.json
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
