# Telegram
BOT_TOKEN=replace-with-a-new-bot-token
ADMIN_IDS=123456789
SUPPORT_URL=https://t.me/your_support_account

# Storage
DATABASE_PATH=/var/lib/free-vpn-bot/free-vpn.sqlite3
CAPTCHA_SECRET=generate-a-long-random-secret

# Public subscription URL. It must use HTTPS in production.
SUBSCRIPTION_BASE_URL=https://vpn.example.com

# VLESS / REALITY public connection settings
PUBLIC_HOST=vpn.example.com
VLESS_PORT=443
REALITY_SERVER_NAME=www.microsoft.com
REALITY_PUBLIC_KEY=replace-with-generated-public-key
REALITY_SHORT_ID=replace-with-hex-short-id

# Server-only REALITY settings. Never commit a real private key.
REALITY_PRIVATE_KEY=replace-with-generated-private-key
REALITY_DEST=www.microsoft.com:443

# Local Xray and configuration synchronization
XRAY_BINARY=/usr/local/bin/xray
XRAY_CONFIG_PATH=/etc/free-vpn-bot/xray.json
XRAY_API_SERVER=127.0.0.1:10085
SYNC_COMMAND=/usr/bin/sudo -n /usr/local/bin/free-vpn-sync
